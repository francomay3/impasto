rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // One source image per project (WebP); path is derived in app from userId + projectId.
    match /users/{userId}/projects/{projectId}/source.webp {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
